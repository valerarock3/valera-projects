  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid",
        "description": "Cookie-сессия, выдаётся после /api/login или /api/register"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Администратор" },
          "email": { "type": "string", "format": "email", "example": "admin@courses.ru" },
          "role": { "type": "string", "enum": ["user", "admin"], "example": "admin" }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "user": { "oneOf": [{ "$ref": "#/components/schemas/User" }, { "type": "null" }] }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "example": "Иван Иванов" },
          "email": { "type": "string", "format": "email", "example": "ivan@mail.ru" },
          "password": { "type": "string", "format": "password", "minLength": 6, "example": "secret1" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "example": "Классический массаж" },
          "description": { "type": "string" }
        }
      },
      "CourseSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "category_id": { "type": "integer", "nullable": true },
          "category_name": { "type": "string", "example": "Классический массаж" },
          "title": { "type": "string", "example": "Классический массаж с нуля" },
          "description": { "type": "string" },
          "price": { "type": "number", "format": "float", "example": 3490 },
          "instructor": { "type": "string", "example": "Елена Соколова" },
          "image_url": { "type": "string", "example": "/uploads/course-js.svg" },
          "lessons_count": { "type": "integer", "example": 5 }
        }
      },
      "Lesson": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "content": { "type": "string", "nullable": true },
          "duration_min": { "type": "integer" },
          "position": { "type": "integer" },
          "video_url": { "type": "string", "nullable": true },
          "image_url": { "type": "string", "nullable": true },
          "quiz": { "type": "array", "items": { "$ref": "#/components/schemas/QuizQuestion" } }
        }
      },
      "QuizQuestion": {
        "type": "object",
        "properties": {
          "q": { "type": "string", "example": "Какой приём используется для разогрева?" },
          "options": { "type": "array", "items": { "type": "string" } },
          "correct": { "type": "integer", "description": "Индекс правильного ответа" }
        }
      },
      "Review": {
        "type": "object",
        "properties": {
          "rating": { "type": "integer", "example": 5 },
          "comment": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "name": { "type": "string", "example": "Иван Иванов" }
        }
      },
      "Media": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "type": { "type": "string", "enum": ["image", "video", "audio"] },
          "url": { "type": "string" }
        }
      },
      "CourseDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "number" },
          "instructor": { "type": "string" },
          "category_id": { "type": "integer", "nullable": true },
          "category_name": { "type": "string" },
          "enrolled": { "type": "boolean", "description": "Записан ли текущий пользователь" },
          "progress": { "type": "integer", "description": "Прогресс 0–100" },
          "isAdmin": { "type": "boolean" },
          "lessons": { "type": "array", "items": { "$ref": "#/components/schemas/Lesson" } },
          "reviews": { "type": "array", "items": { "$ref": "#/components/schemas/Review" } },
          "media": { "type": "array", "items": { "$ref": "#/components/schemas/Media" } }
        }
      },
      "EnrolledCourse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "price": { "type": "number" },
          "instructor": { "type": "string" },
          "image_url": { "type": "string" },
          "progress": { "type": "integer", "example": 40 },
          "enrolled_at": { "type": "string", "format": "date-time" }
        }
      },
      "SmsSendRequest": {
        "type": "object",
        "required": ["courseId", "payment"],
        "properties": {
          "courseId": { "type": "integer", "example": 1 },
          "payment": {
            "type": "object",
            "required": ["method"],
            "properties": {
              "method": { "type": "string", "example": "card" },
              "card_last4": { "type": "string", "example": "4242" }
            }
          }
        }
      },
      "AdminUser": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "courses_count": { "type": "integer" },
          "courses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "title": { "type": "string" }
              }
            }
          }
        }
      },
      "CourseWrite": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "example": "Детский массаж" },
          "description": { "type": "string" },
          "price": { "type": "number", "example": 2990 },
          "category_id": { "type": "integer", "nullable": true },
          "instructor": { "type": "string" },
          "image_url": { "type": "string" }
        }
      },
      "LessonWrite": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "example": "Техника поглаживания" },
          "content": { "type": "string" },
          "duration_min": { "type": "integer", "example": 30 },
          "video_url": { "type": "string" },
          "image_url": { "type": "string" },
          "quiz": {
            "type": "string",
            "description": "JSON-строка: [{\"q\": \"...\", \"options\": [\"...\"], \"correct\": 0}]"
          }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "amount": { "type": "number" },
          "method": { "type": "string" },
          "card_last4": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "course_title": { "type": "string" },
          "user_name": { "type": "string" }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Некорректные данные запроса",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Требуется вход (нет авторизации)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "Доступ запрещён (недостаточно прав)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Ресурс не найден",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Success": {
        "description": "Операция успешна",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SuccessResponse" }
          }
        }
      }
    }
  }
}
