{
  "openapi": "3.0.0",
  "info": {
    "title": "Платформа онлайн-курсов по массажу «Курсы»",
    "description": "REST API платформы онлайн-курсов. Авторизация — на основе cookie-сессий (`express-session`). Демо-доступы: админ `admin@courses.ru / admin123`, пользователь `user@courses.ru / user123`.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3001", "description": "Локальный сервер" }
  ],
  "tags": [
    { "name": "Аутентификация", "description": "Регистрация, вход, выход, текущий пользователь" },
    { "name": "Каталог", "description": "Категории и курсы (публичный доступ)" },
    { "name": "Обучение", "description": "Запись на курс, прогресс, отзывы, скачивание уроков, сертификат" },
    { "name": "Оплата", "description": "SMS-подтверждение оплаты" },
    { "name": "Файлы", "description": "Загрузка файлов на сервер" },
    { "name": "Администрирование", "description": "Управление пользователями, категориями, курсами, уроками, медиа и оплатами" }
  ],
  "paths": {
    "/api/me": {
      "get": {
        "tags": ["Аутентификация"],
        "summary": "Текущий пользователь",
        "description": "Возвращает данные авторизованного пользователя из сессии или null.",
        "security": [],
        "responses": {
          "200": {
            "description": "Данные пользователя (или null, если не авторизован)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeResponse" }
              }
            }
          }
        }
      }
    },
    "/api/register": {
      "post": {
        "tags": ["Аутентификация"],
        "summary": "Регистрация нового пользователя",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Пользователь создан и автоматически авторизован",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": {
            "description": "Email уже зарегистрирован",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": ["Аутентификация"],
        "summary": "Вход по email и паролю",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "admin@courses.ru" },
                  "password": { "type": "string", "format": "password", "example": "admin123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Вход выполнен, сессия создана",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": {
            "description": "Неверный email или пароль",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "tags": ["Аутентификация"],
        "summary": "Выход из аккаунта (уничтожает сессию)",
        "security": [],
        "responses": {
          "200": {
            "description": "Сессия завершена",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
              }
            }
          }
        }
      }
    },

    "/api/categories": {
      "get": {
        "tags": ["Каталог"],
        "summary": "Список категорий курсов",
        "security": [],
        "responses": {
          "200": {
            "description": "Категории, отсортированные по имени",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Category" }
                }
              }
            }
          }
        }
      }
    },
    "/api/courses": {
      "get": {
        "tags": ["Каталог"],
        "summary": "Список курсов",
        "description": "Возвращает краткую информацию по всем курсам. Можно фильтровать по категории.",
        "security": [],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "ID категории для фильтрации"
          }
        ],
        "responses": {
          "200": {
            "description": "Список курсов",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CourseSummary" }
                }
              }
            }
          }
        }
      }
    },
    "/api/courses/{id}": {
      "get": {
        "tags": ["Каталог"],
        "summary": "Детальная информация о курсе",
        "description": "Содержит уроки, отзывы и медиа. Уроки платных курсов доступны только записанным пользователям и администраторам (кроме первого — демо-урока).",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "ID курса"
          }
        ],
        "responses": {
          "200": {
            "description": "Полная информация о курсе",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CourseDetail" }
              }
            }
          },
          "404": {
            "description": "Курс не найден",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },

    "/api/courses/{courseId}/lessons/{lessonId}/download": {
      "get": {
        "tags": ["Обучение"],
        "summary": "Скачать урок в формате HTML",
        "description": "Требует авторизации и записи на курс.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "lessonId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML-файл урока (attachment)",
            "content": {
              "text/html": { "schema": { "type": "string" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/courses/{id}/enroll": {
      "post": {
        "tags": ["Обучение"],
        "summary": "Запись на бесплатный курс",
        "description": "Для платных курсов вернёт ошибку — оплата проходит через SMS-подтверждение.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Запись оформлена (или уже существовала)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "paid": { "type": "boolean", "example": false }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/courses/{id}/progress": {
      "post": {
        "tags": ["Обучение"],
        "summary": "Обновить прогресс курса",
        "description": "Передаётся ID пройденного урока, прогресс пересчитывается как позиция последнего урока. Прогресс только растёт.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["lessonId"],
                "properties": {
                  "lessonId": { "type": "integer", "description": "ID пройденного урока" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Новый прогресс (0–100)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "progress": { "type": "integer", "example": 40 }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/courses/{id}/review": {
      "post": {
        "tags": ["Обучение"],
        "summary": "Оставить (или обновить) отзыв о курсе",
        "description": "Требует записи на курс. Один пользователь — один отзыв на курс (при повторной отправке обновляется).",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["rating"],
                "properties": {
                  "rating": { "type": "integer", "minimum": 1, "maximum": 5, "example": 5 },
                  "comment": { "type": "string", "example": "Отличный курс!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/my": {
      "get": {
        "tags": ["Обучение"],
        "summary": "Мои курсы",
        "description": "Курсы, на которые записан текущий пользователь, с прогрессом.",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Список курсов пользователя",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/EnrolledCourse" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/certificate/{courseId}": {
      "get": {
        "tags": ["Обучение"],
        "summary": "Скачать сертификат (PDF)",
        "description": "Доступен после полного прохождения курса (прогресс 100%). Возвращает PDF A4 landscape.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF-файл сертификата",
            "content": {
              "application/pdf": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "Курс не оплачен или не завершён",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },

    "/api/payment/sms-send": {
      "post": {
        "tags": ["Оплата"],
        "summary": "Шаг 1: запросить SMS-код для оплаты",
        "description": "Генерирует 6-значный код, сохраняет платёж и возвращает код в ответе (демо-режим).",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SmsSendRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Код отправлен (в демо — возвращается)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "demoCode": { "type": "string", "example": "482913" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/payment/sms-confirm": {
      "post": {
        "tags": ["Оплата"],
        "summary": "Шаг 2: подтвердить SMS-код и завершить оплату",
        "description": "Проверяет код, создаёт платёж и записывает пользователя на курс.",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["courseId", "code"],
                "properties": {
                  "courseId": { "type": "integer", "example": 1 },
                  "code": { "type": "string", "description": "6-значный SMS-код", "example": "482913" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Оплата прошла, доступ открыт",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "paid": { "type": "boolean", "example": true }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },

    "/api/upload": {
      "post": {
        "tags": ["Файлы"],
        "summary": "Загрузить файл (изображение / видео / аудио)",
        "description": "Multipart/form-data, поле `file`. Максимальный размер 500 МБ. SVG запрещён (риск XSS).",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Файл загружен",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": { "type": "string", "example": "/uploads/1730123456789-123456.jpg" },
                    "name": { "type": "string", "example": "photo.jpg" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },

    "/api/admin/users": {
      "get": {
        "tags": ["Администрирование"],
        "summary": "Список пользователей (с их курсами)",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Список пользователей",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AdminUser" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/users/{id}": {
      "delete": {
        "tags": ["Администрирование"],
        "summary": "Удалить пользователя",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": {
            "description": "Нельзя удалить самого себя / последнего администратора",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/admin/users/{id}/role": {
      "post": {
        "tags": ["Администрирование"],
        "summary": "Изменить роль пользователя (user/admin)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["role"],
                "properties": {
                  "role": { "type": "string", "enum": ["user", "admin"], "example": "admin" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/admin/users/{id}/courses/{courseId}": {
      "delete": {
        "tags": ["Администрирование"],
        "summary": "Снять пользователя с курса",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "ID пользователя"
          },
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "ID курса"
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },

    "/api/admin/categories": {
      "post": {
        "tags": ["Администрирование"],
        "summary": "Создать категорию",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "example": "Детский массаж" },
                  "description": { "type": "string", "example": "Техники массажа для детей" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/categories/{id}": {
      "delete": {
        "tags": ["Администрирование"],
        "summary": "Удалить категорию",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },

    "/api/admin/courses": {
      "post": {
        "tags": ["Администрирование"],
        "summary": "Создать курс",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CourseWrite" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Курс создан",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "id": { "type": "integer", "example": 6 }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/courses/{id}": {
      "put": {
        "tags": ["Администрирование"],
        "summary": "Обновить курс",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CourseWrite" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "delete": {
