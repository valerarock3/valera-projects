    "/api/admin/courses/{id}/media": {
      "post": {
        "tags": ["Администрирование"],
        "summary": "Добавить медиа к курсу",
        "description": "Тип определяется автоматически по расширению или URL.",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
